      "description": "User-created Claude projects under Documents. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": ".claude",
      "category": "applicationData",
      "description": "Claude Code configuration, sessions, commands, and local state. Protected from cleanup.",
      "inventoryDepth": 1
    },
    {
      "relativePath": ".claude-vision",
      "category": "applicationData",
      "description": "Claude-related local vision data. Protected from cleanup.",
      "inventoryDepth": 1
    }
