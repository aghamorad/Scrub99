      "category": "preferences",
      "description": "Preferences and settings file."
    },
    {
      "relativePath": "Library/Logs/Claude",
      "category": "logs",
      "description": "Log files."
    },
    {
      "relativePath": "Library/Saved Application State/com.anthropic.claude.savedState",
      "category": "applicationData",
      "description": "Saved app state."
    },
    {
      "relativePath": "Library/Containers/com.anthropic.claude",
      "category": "applicationData",
      "description": "Sandbox container."
    },
    {
      "relativePath": "Library/Group Containers/com.anthropic.claude",
      "category": "applicationData",
      "description": "Shared container."
    },
    {
      "relativePath": "Claude",
      "category": "projectData",
